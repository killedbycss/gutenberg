<Page x:Class="GutenbergWindows.ConverterPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="20" RowSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Добавить файлы…" Click="Add_Click"/><Button Content="Очистить" Click="Clear_Click"/><TextBlock x:Name="FileCount" Text="Файлы не выбраны" VerticalAlignment="Center"/></StackPanel>
    <ListView x:Name="Files" Grid.Row="1"/>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12"><CheckBox x:Name="Otf" Content="OTF"/><CheckBox x:Name="Ttf" Content="TTF"/><CheckBox x:Name="Woff" Content="WOFF"/><CheckBox x:Name="Woff2" Content="WOFF2" IsChecked="True"/><CheckBox x:Name="Png" Content="PNG"/><CheckBox x:Name="Jpg" Content="JPG"/><CheckBox x:Name="Webp" Content="WEBP"/><Button Content="Конвертировать…" Style="{StaticResource AccentButtonStyle}" Click="Convert_Click"/></StackPanel>
    <InfoBar x:Name="Status" Grid.Row="3" IsOpen="False" IsClosable="True"/>
  </Grid>
</Page>
