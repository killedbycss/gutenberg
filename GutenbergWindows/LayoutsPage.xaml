<Page x:Class="GutenbergWindows.LayoutsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="20" ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <ScrollViewer><StackPanel Spacing="12"><TextBlock Text="Макет" Style="{StaticResource TitleTextBlockStyle}"/><ComboBox x:Name="Preset" Header="Назначение" SelectedIndex="0" SelectionChanged="UpdatePreview"><ComboBoxItem Content="Пост · 1080×1080" Tag="post"/><ComboBoxItem Content="История · 1080×1920" Tag="story"/><ComboBoxItem Content="Обложка · 1600×900" Tag="cover"/><ComboBoxItem Content="Постер · 1240×1754" Tag="poster"/><ComboBoxItem Content="Визитка · 1050×600" Tag="card"/></ComboBox><TextBox x:Name="TitleText" Header="Заголовок" Text="Искусство формы" TextChanged="UpdatePreview"/><TextBox x:Name="SubtitleText" Header="Подзаголовок" Text="Типографический макет" TextChanged="UpdatePreview"/><TextBox x:Name="BodyText" Header="Текст" Text="Добавьте собственный текст и экспортируйте готовую композицию." AcceptsReturn="True" TextWrapping="Wrap" Height="110" TextChanged="UpdatePreview"/><Button Content="Выбрать шрифт…" Click="Font_Click"/><TextBlock x:Name="FontStatus" Text="Системный шрифт" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Button Content="Экспортировать PNG…" Style="{StaticResource AccentButtonStyle}" Click="Export_Click"/><InfoBar x:Name="Status" IsOpen="False" IsClosable="True"/></StackPanel></ScrollViewer>
    <Viewbox Grid.Column="1" Stretch="Uniform"><Grid x:Name="Canvas" Width="1080" Height="1080"><Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF20222E"/><GradientStop Color="#FF542E61" Offset="1"/></LinearGradientBrush></Grid.Background><StackPanel VerticalAlignment="Bottom" Margin="82" Spacing="20"><TextBlock x:Name="PreviewTitle" Text="Искусство формы" Foreground="White" FontFamily="Georgia" FontSize="82" FontWeight="Bold" TextWrapping="Wrap" MaxLines="3"/><TextBlock x:Name="PreviewSubtitle" Text="ТИПОГРАФИЧЕСКИЙ МАКЕТ" Foreground="White" FontSize="25" FontWeight="SemiBold" CharacterSpacing="140"/><Rectangle Height="2" Fill="White" Opacity="0.5"/><TextBlock x:Name="PreviewBody" Text="Добавьте собственный текст и экспортируйте готовую композицию." Foreground="White" FontSize="22" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left" MaxLines="5"/></StackPanel></Grid></Viewbox>
  </Grid>
</Page>
