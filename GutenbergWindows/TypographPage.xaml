<Page x:Class="GutenbergWindows.TypographPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="20" RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Spacing="12"><CheckBox x:Name="Quotes" Content="Кавычки" IsChecked="True"/><CheckBox x:Name="Dashes" Content="Тире" IsChecked="True"/><CheckBox x:Name="Spaces" Content="Неразрывные пробелы" IsChecked="True"/><CheckBox x:Name="British" Content="Британские тире"/><Button Content="Типографировать" Style="{StaticResource AccentButtonStyle}" Click="Process_Click"/></StackPanel>
    <Grid Grid.Row="1" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="Source" Header="Исходный текст" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Text="Он сказал &quot;привет&quot; в 1990-2000."/><TextBox x:Name="Result" Grid.Column="1" Header="Результат" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/></Grid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"><Button Content="Копировать результат" Click="Copy_Click"/><InfoBar x:Name="Status" IsOpen="False" IsClosable="True"/></StackPanel>
  </Grid>
</Page>
